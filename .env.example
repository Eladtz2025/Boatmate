# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Used to build magic-link redirect URLs. Set to your deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project Settings → API → service_role. Server-only: it bypasses RLS and can
# mint sessions, which is what email-only sign-in needs. Never expose it to the
# browser and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Google Calendar — optional. Syncs attendance ("who is on the boat, and when")
# to one shared boat calendar that every partner subscribes to.
#
# There is no OAuth flow: a Google Cloud *service account* holds the credential,
# and the calendar is shared with its address with "Make changes to events".
# That keeps the server holding one key instead of a token per partner.
#
# Leave these unset and the app behaves exactly as before — attendance saves,
# nothing is sent to Google, and Settings says "לא מחובר" rather than implying
# a sync that is not happening.
#
# GOOGLE_PRIVATE_KEY is the service account's PEM key. In a single-line env
# field keep the literal \n sequences; they are expanded when it is read.
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=boatmate@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
