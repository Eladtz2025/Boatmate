# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Used to build magic-link redirect URLs **and the Google OAuth redirect_uri**.
# In production this MUST be the deployed origin with no trailing slash, because
# `${NEXT_PUBLIC_SITE_URL}/api/google/callback` has to match what is registered
# in Google Cloud byte for byte — a mismatch is a redirect_uri_mismatch error at
# the consent screen, not a silent degradation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project Settings → API → service_role. Server-only: it bypasses RLS and can
# mint sessions, which is what email-only sign-in needs. Never expose it to the
# browser and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Web Push — the boat's notification channel. Required for partners to be told
# automatically when somebody marks, changes or cancels attendance.
#
# Generate a key pair once, with the dependency this project already has:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# The public half is NEXT_PUBLIC_ because the browser needs it to subscribe;
# the private half must never leave the server. VAPID_SUBJECT is a contact the
# push services can reach and is required by the spec.
#
# Also needs supabase/migrations/20260902120000_push_subscriptions.sql applied.
# With either missing, attendance still saves and the app says out loud that no
# notification went out — it never claims one did.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Gmail invoice import — optional. Reads invoices sent by Invoice One and turns
# them into expenses.
#
# A "Web application" OAuth client in Google Cloud, with Gmail API enabled and
# the single scope gmail.readonly. Its authorized redirect URI must be exactly
#   https://<your-domain>/api/google/callback
# and no Authorized JavaScript Origin is needed — the code exchange happens
# server-side, with the secret, and no token ever reaches the browser.
#
# Also needs supabase/migrations/20260902130000_gmail_invoice_import.sql applied.
# With either missing, the Settings card says so and the sync refuses rather
# than importing anything.
# ---------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Google Calendar — optional. Syncs attendance ("who is on the boat, and when")
# to one shared boat calendar that every partner subscribes to.
#
# There is no OAuth flow: a Google Cloud *service account* holds the credential,
# and the calendar is shared with its address with "Make changes to events".
# That keeps the server holding one key instead of a token per partner.
#
# Leave these unset and the app behaves exactly as before — attendance saves,
# nothing is sent to Google, and Settings says "לא מחובר" rather than implying
# a sync that is not happening.
#
# GOOGLE_PRIVATE_KEY is the service account's PEM key. In a single-line env
# field keep the literal \n sequences; they are expanded when it is read.
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=boatmate@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
