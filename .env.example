# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Used to build magic-link redirect URLs. Set to your deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project Settings → API → service_role. Server-only: it bypasses RLS and can
# mint sessions, which is what email-only sign-in needs. Never expose it to the
# browser and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
